{{define "title"}}Note #{{.ID}}{{end}}

{{define "main"}}
	<div class='note'>
		<div class='metadata'>
			<strong>{{.Title}}</strong>
			<span>#{{.ID}}</span>
		</div>

		<pre><code>{{.Content}}</code></pre>
		
		<div class='metadata'>
			<time>Created: {{.Created}}</time>
			<time>Expires: {{.Expires}}</time>
		</div>
	</div>
{{end}}
